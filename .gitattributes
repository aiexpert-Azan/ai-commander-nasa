# Normalize text files to LF in the repo; keep Windows scripts as CRLF on checkout.
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf

# Trained model and processed Kepler data: byte-exact (verified by backend/ASSETS.sha256),
# so never convert line endings, even for the JSON config.
backend/models/** binary
backend/data/** binary
*.keras binary
*.npz binary
*.h5 binary
